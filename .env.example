# Application Environment
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_NAME=Modular React Ridhuan
VITE_APP_ENV=development

# ColorHunt 4-Color Palette Configuration (https://colorhunt.co/)
# Formats: Hex (#RRGGBB) or OKLCH. Used by the modular CLI theme injector.
VITE_THEME_PALETTE_NAME=modern-indigo
VITE_COLOR_PRIMARY=#4F46E5
VITE_COLOR_SECONDARY=#64748B
VITE_COLOR_ACCENT=#06B6D4
VITE_COLOR_BACKGROUND=#F8FAFC
